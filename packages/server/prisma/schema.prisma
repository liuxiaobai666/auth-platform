// 卡密平台数据模型（MySQL 8+）
// 对应 DEVELOPMENT.md 第 11 章，并补充远程管控与版本发布相关表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================== 管理员与权限 ==============================

model AdminUser {
  id           String      @id @db.VarChar(32)
  username     String      @unique @db.VarChar(64)
  passwordHash String      @db.VarChar(255)
  nickname     String      @db.VarChar(64)
  email        String?     @db.VarChar(128)
  isSuperAdmin Boolean     @default(false)
  status       AdminStatus @default(active)
  failedCount  Int         @default(0)
  lockedUntil  DateTime?   @db.DateTime(3)
  lastLoginAt  DateTime?   @db.DateTime(3)
  lastLoginIp  String?     @db.VarChar(64)
  tokenVersion Int         @default(0)
  createdAt    DateTime    @default(now()) @db.DateTime(3)
  updatedAt    DateTime    @updatedAt @db.DateTime(3)

  roles     AdminUserRole[]
  auditLogs AuditLog[]
  exports   LicenseKeyExport[]

  @@map("admin_users")
}

model AdminRole {
  id          String   @id @db.VarChar(32)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  permissions Json
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  users AdminUserRole[]

  @@map("admin_roles")
}

model AdminUserRole {
  adminUserId String   @db.VarChar(32)
  roleId      String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

enum AdminStatus {
  active
  disabled
}

// ============================== 应用与插件 ==============================

model Application {
  id     String    @id @db.VarChar(32)
  appId  String    @unique @db.VarChar(64)
  name   String    @db.VarChar(128)
  type   AppType   @default(windows)
  status AppStatus @default(active)
  remark String?   @db.VarChar(500)

  // ---- 远程管控策略 ----
  // killSwitch 为真时所有验证请求立即拒绝，用于紧急熔断。
  killSwitch         Boolean     @default(false)
  killMessage        String?     @db.VarChar(500)
  // 维护模式：拒绝新激活，但已激活设备仍可验证通过。
  maintenance        Boolean     @default(false)
  maintenanceMessage String?     @db.VarChar(500)
  // 版本策略
  minVersion         String?     @db.VarChar(32)
  latestVersion      String?     @db.VarChar(32)
  forceUpgrade       Boolean     @default(false)
  upgradeMessage     String?     @db.VarChar(500)
  // 公告
  noticeEnabled      Boolean     @default(false)
  noticeLevel        NoticeLevel @default(info)
  noticeTitle        String?     @db.VarChar(128)
  noticeContent      String?     @db.Text
  // 客户端策略缓存秒数，SDK 据此决定下次拉取策略的间隔
  policyTtlSeconds   Int         @default(300)

  // ---- 更新包签名（Ed25519）----
  // 私钥加密存储、只在服务端签名时解密；公钥需由开发者内置进客户端做验签。
  // 公钥绝不通过 policy 下发：否则篡改响应的人可以连公钥一起换掉，验签就形同虚设。
  updateSignPublicKey  String? @db.VarChar(128)
  updateSignPrivateKey String? @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  plugins          ApplicationPlugin[]
  plans            Plan[]
  licenseKeys      LicenseKey[]
  releases         AppRelease[]
  activations      LicenseActivation[]
  batches          LicenseBatch[]
  webhookEndpoints WebhookEndpoint[]
  distSite         AppDistSite?

  @@map("applications")
}

enum AppType {
  windows
  android
  web
  api
  other
}

enum AppStatus {
  active
  disabled
}

enum NoticeLevel {
  info
  warning
  critical
}

model ApplicationPlugin {
  id            String        @id @db.VarChar(32)
  pluginId      String        @unique @db.VarChar(64)
  applicationId String        @db.VarChar(32)
  name          String        @db.VarChar(128)
  version       String        @default("1.0.0") @db.VarChar(32)
  runtime       PluginRuntime @default(sdk)
  endpoint      String?       @db.VarChar(255)
  status        PluginStatus  @default(testing)

  // Bearer Token：只存哈希用于校验，密文用于管理员按权限重新查看
  tokenHash           String    @unique @db.VarChar(64)
  tokenCipher         String    @db.Text
  tokenMasked         String    @db.VarChar(64)
  // 签名密钥必须可逆解密才能参与 HMAC 计算
  secretCipher        String    @db.Text
  secretMasked        String    @db.VarChar(64)
  prevSecretCipher    String?   @db.Text
  prevSecretExpiresAt DateTime? @db.DateTime(3)

  config    Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_plugins")
}

enum PluginRuntime {
  sdk
  http
  webhook
  service
}

enum PluginStatus {
  draft
  testing
  active
  disabled
}

// ============================== 套餐 ==============================

model Plan {
  id                String     @id @db.VarChar(32)
  applicationId     String     @db.VarChar(32)
  code              String     @db.VarChar(64)
  name              String     @db.VarChar(128)
  // 为空表示永久卡
  durationDays      Int?
  deviceLimit       Int        @default(1)
  allowRebind       Boolean    @default(true)
  // 为空表示不限换绑次数；allowRebind 为 false 时忽略
  rebindLimit       Int?
  price             Decimal    @default(0) @db.Decimal(10, 2)
  offlineGraceHours Int        @default(72)
  /// 每台设备的次数额度：null = 不限次（普通时间/永久卡）；有值 = 次数卡，每设备独立额度
  quotaPerDevice    Int?
  status            PlanStatus @default(active)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now()) @db.DateTime(3)
  updatedAt         DateTime   @updatedAt @db.DateTime(3)

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  licenseKeys LicenseKey[]
  batches     LicenseBatch[]

  @@unique([applicationId, code])
  @@index([applicationId])
  @@map("plans")
}

enum PlanStatus {
  active
  inactive
}

// ============================== 卡密 ==============================

model LicenseKey {
  id            String @id @db.VarChar(32)
  applicationId String @db.VarChar(32)
  planId        String @db.VarChar(32)

  // 四列存储方案：哈希校验 / 密文导出 / 脱敏展示 / 前缀搜索
  keyHash   String @unique @db.VarChar(64)
  keyCipher String @db.Text
  keyMasked String @db.VarChar(64)
  keyPrefix String @db.VarChar(16)

  status LicenseStatus @default(unused)

  // 生成时从套餐快照下来，允许单卡覆盖
  durationDays      Int?
  deviceLimit       Int     @default(1)
  allowRebind       Boolean @default(true)
  rebindLimit       Int?
  rebindCount       Int     @default(0)
  offlineGraceHours Int     @default(72)
  /// 次数卡：每台设备的额度快照，null = 不限次
  quotaPerDevice    Int?

  batchId     String    @db.VarChar(32)
  note        String?   @db.VarChar(255)
  activatedAt DateTime? @db.DateTime(3)
  expiresAt   DateTime? @db.DateTime(3)

  // 递增即可让该卡密已签发的所有令牌立即失效
  tokenVersion Int @default(0)

  bannedAt      DateTime? @db.DateTime(3)
  bannedReason  String?   @db.VarChar(255)
  revokedAt     DateTime? @db.DateTime(3)
  revokedReason String?   @db.VarChar(255)

  createdBy String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  application  Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan         Plan                 @relation(fields: [planId], references: [id])
  devices      LicenseDevice[]
  activations  LicenseActivation[]
  reservations LicenseReservation[]

  @@index([applicationId, status])
  @@index([keyPrefix])
  @@index([batchId])
  @@index([expiresAt])
  @@map("license_keys")
}

enum LicenseStatus {
  unused
  active
  expired
  banned
  revoked
}

model LicenseDevice {
  id        String @id @db.VarChar(32)
  licenseId String @db.VarChar(32)
  deviceId  String @db.VarChar(128)

  deviceName    String?          @db.VarChar(128)
  clientVersion String?          @db.VarChar(32)
  status        DeviceBindStatus @default(active)

  // 次数卡的设备级额度：可用 = quotaTotal - quotaUsed - quotaReserved
  // quotaTotal 为 null 表示这台设备不限次
  quotaTotal    Int?
  quotaUsed     Int  @default(0)
  quotaReserved Int  @default(0)

  firstSeenAt   DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt    DateTime  @default(now()) @db.DateTime(3)
  lastIp        String?   @db.VarChar(64)
  unboundAt     DateTime? @db.DateTime(3)
  unboundBy     String?   @db.VarChar(64)
  unboundReason String?   @db.VarChar(255)

  licenseKey LicenseKey @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  // 同一卡密下设备唯一，解绑保留行并置为 unbound，重新绑定时复用该行
  @@unique([licenseId, deviceId])
  @@index([deviceId])
  @@map("license_devices")
}

enum DeviceBindStatus {
  active
  unbound
}

// 次数卡的预扣记录（预扣-确认两阶段）。
// reserve 冻结额度 → confirm 真扣 / release 退回 / 超时自动 expired 释放。
model LicenseReservation {
  id        String @id @db.VarChar(32)
  licenseId String @db.VarChar(32)
  deviceId  String @db.VarChar(128)
  amount    Int

  status         ReservationStatus @default(reserved)
  // reserve 的幂等键：同一 (license, key) 重复 reserve 返回原记录，不重复冻结
  idempotencyKey String?           @db.VarChar(128)

  expiresAt   DateTime  @db.DateTime(3)
  confirmedAt DateTime? @db.DateTime(3)
  releasedAt  DateTime? @db.DateTime(3)
  pluginId    String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  licenseKey LicenseKey @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([licenseId, deviceId])
  @@map("license_reservations")
}

enum ReservationStatus {
  reserved
  confirmed
  released
  expired
}

// 授权日志：激活、验证、解绑、状态查询的全量流水
model LicenseActivation {
  id            String  @id @db.VarChar(32)
  licenseId     String? @db.VarChar(32)
  applicationId String? @db.VarChar(32)
  pluginId      String? @db.VarChar(64)
  deviceId      String? @db.VarChar(128)

  action  LicenseAction
  success Boolean
  code    String?       @db.VarChar(64)
  message String?       @db.VarChar(255)

  clientVersion String?  @db.VarChar(32)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @db.VarChar(255)
  requestId     String?  @db.VarChar(64)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  licenseKey  LicenseKey?  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([licenseId, createdAt])
  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("license_activations")
}

enum LicenseAction {
  activate
  verify
  deactivate
  status
  policy
  consume
}

// 令牌撤销表：按 jti 精确撤销，配合 tokenVersion 的批量撤销
model LicenseTokenRevocation {
  jti       String   @id @db.VarChar(64)
  licenseId String   @db.VarChar(32)
  reason    String?  @db.VarChar(255)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([licenseId])
  @@index([expiresAt])
  @@map("license_token_revocations")
}

model LicenseBatch {
  id            String @id @db.VarChar(32)
  applicationId String @db.VarChar(32)
  planId        String @db.VarChar(32)

  count     Int
  prefix    String?  @db.VarChar(16)
  /// 渠道标记：卡密卖给哪个发卡网/代理，用于追踪盗版来源
  channel   String?  @db.VarChar(64)
  note      String?  @db.VarChar(255)
  createdBy String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan        Plan        @relation(fields: [planId], references: [id])

  @@index([applicationId, createdAt])
  @@index([channel])
  @@map("license_batches")
}

model LicenseKeyExport {
  id            String   @id @db.VarChar(32)
  adminUserId   String   @db.VarChar(32)
  applicationId String?  @db.VarChar(32)
  batchId       String?  @db.VarChar(32)
  filter        Json?
  count         Int
  ip            String?  @db.VarChar(64)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@map("license_key_exports")
}

// ============================== 版本发布与安装包托管 ==============================

model AppRelease {
  id            String         @id @db.VarChar(32)
  applicationId String         @db.VarChar(32)
  version       String         @db.VarChar(32)
  channel       ReleaseChannel @default(stable)

  fileName    String? @db.VarChar(255)
  filePath    String? @db.VarChar(500)
  fileSize    BigInt?
  sha256      String? @db.VarChar(64)
  externalUrl String? @db.VarChar(500)

  // ---- 更新包元数据：告诉客户端「这个包该怎么装」----
  packageType     PackageType     @default(zip)
  installStrategy InstallStrategy @default(versioned)
  // 压缩包里若多套了一层目录（如 dist/YourApp/），解压时剥掉
  stripRootDir    Boolean         @default(false)
  // 新版入口：Python/C# 填 app.exe，Node 填 main.js，PHP 填 index.php
  entry           String?         @db.VarChar(255)
  // 装完要执行的命令，如 pip install -r requirements.txt
  postInstall     String?         @db.VarChar(500)
  // Ed25519 签名（base64）。签的是 版本+哈希+大小，防篡改也防版本回滚
  signature       String?         @db.VarChar(128)

  // ---- 完整安装包（给新用户下载，含启动器等更新包里没有的东西）----
  // 与上面的更新包是同一个版本的两种形态：老用户走更新包，新用户下这个。
  installerName        String? @db.VarChar(255)
  installerPath        String? @db.VarChar(500)
  installerSize        BigInt?
  installerSha256      String? @db.VarChar(64)
  installerExternalUrl String? @db.VarChar(500)

  releaseNotes   String?       @db.Text
  isMandatory    Boolean       @default(false)
  // 0-100，按设备指纹哈希稳定分桶，保证同一设备灰度结果不跳变
  rolloutPercent Int           @default(100)
  status         ReleaseStatus @default(draft)

  downloadCount Int       @default(0)
  publishedAt   DateTime? @db.DateTime(3)
  createdBy     String?   @db.VarChar(32)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version, channel])
  @@index([applicationId, status])
  @@map("app_releases")
}

/// 应用的对外分发页：给新用户看的下载站，和后台完全隔离。
model AppDistSite {
  id            String  @id @db.VarChar(32)
  applicationId String  @unique @db.VarChar(32)
  /// 访问路径 /d/<slug>。独立于 appId，改域名展示不影响接入标识
  slug          String  @unique @db.VarChar(64)
  enabled       Boolean @default(false)

  title       String? @db.VarChar(128)
  tagline     String? @db.VarChar(255)
  logoUrl     String? @db.VarChar(500)
  /// 使用说明，markdown
  intro       String? @db.Text
  purchaseUrl String? @db.VarChar(500)

  supportQq     String? @db.VarChar(64)
  supportWechat String? @db.VarChar(64)
  supportEmail  String? @db.VarChar(128)

  /// 开启后必须先验卡密才给下载地址，防止未购买的人拿到安装包
  requireLicense Boolean @default(true)
  showChangelog  Boolean @default(true)
  /// 下载次数，只做展示与粗略统计
  downloadCount  Int     @default(0)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("app_dist_sites")
}

enum PackageType {
  zip
  onefile
  onedir
}

enum InstallStrategy {
  // 解压到独立版本目录后切换指针，可原子回滚（推荐）
  versioned
  // 原地覆盖/自替换
  replace
  // 只通知有新版，安装交给宿主自己处理（Electron autoUpdater、运维脚本等）
  notify
}

enum ReleaseChannel {
  stable
  beta
}

enum ReleaseStatus {
  draft
  published
  archived
}

// ============================== 幂等与日志 ==============================

model WebhookEndpoint {
  id            String   @id @db.VarChar(32)
  applicationId String   @db.VarChar(32)
  url           String   @db.VarChar(500)
  /// 签名密钥的密文，推送时解密用来算 HMAC
  secretCipher  String   @db.Text
  secretMasked  String   @db.VarChar(64)
  /// 订阅的事件类型，为空表示全部
  events        Json?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([applicationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String @id @db.VarChar(32)
  endpointId String @db.VarChar(32)
  eventId    String @db.VarChar(32)
  eventType  String @db.VarChar(48)
  payload    Json

  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(6)
  nextRetryAt    DateTime?             @db.DateTime(3)
  lastStatusCode Int?
  lastError      String?               @db.VarChar(500)
  deliveredAt    DateTime?             @db.DateTime(3)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @db.DateTime(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextRetryAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  dead
}

model IdempotencyRecord {
  id           String   @id @db.VarChar(32)
  pluginId     String   @db.VarChar(64)
  endpoint     String   @db.VarChar(128)
  idemKey      String   @db.VarChar(128)
  requestHash  String   @db.VarChar(64)
  statusCode   Int
  responseBody String   @db.Text
  createdAt    DateTime @default(now()) @db.DateTime(3)
  expiresAt    DateTime @db.DateTime(3)

  @@unique([pluginId, endpoint, idemKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditLog {
  id          String   @id @db.VarChar(32)
  adminUserId String?  @db.VarChar(32)
  username    String?  @db.VarChar(64)
  action      String   @db.VarChar(64)
  targetType  String?  @db.VarChar(64)
  targetId    String?  @db.VarChar(64)
  detail      Json?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginLog {
  id          String   @id @db.VarChar(32)
  username    String   @db.VarChar(64)
  adminUserId String?  @db.VarChar(32)
  success     Boolean
  failReason  String?  @db.VarChar(64)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([username, createdAt])
  @@index([createdAt])
  @@map("login_logs")
}

model ApiRequestLog {
  id          String   @id @db.VarChar(32)
  requestId   String   @db.VarChar(64)
  method      String   @db.VarChar(8)
  path        String   @db.VarChar(255)
  pluginId    String?  @db.VarChar(64)
  adminUserId String?  @db.VarChar(32)
  statusCode  Int
  code        String?  @db.VarChar(64)
  durationMs  Int
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt])
  @@index([pluginId, createdAt])
  @@map("api_request_logs")
}
