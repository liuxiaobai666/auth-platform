# ==== 数据库 ====
DATABASE_URL="mysql://user:password@127.0.0.1:3306/jc_kami"

# ==== Redis ====
REDIS_URL="redis://127.0.0.1:6379/0"

# ==== 服务 ====
PORT=3100
NODE_ENV=development

# ==== 密钥（生产环境务必更换，且不要提交到仓库）====
# 管理员 access / refresh token 签名密钥
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="7d"

# 授权令牌 license_token 的签名密钥
LICENSE_TOKEN_SECRET="dev-license-token-secret-change-me-0123456789"
LICENSE_TOKEN_TTL_HOURS=24

# 卡密哈希用的 pepper，一旦上线不可更换，否则所有卡密无法校验
LICENSE_KEY_PEPPER="dev-license-pepper-change-me-0123456789abcdef"

# 可逆加密主密钥，必须是 64 位十六进制（32 字节）
# 用于加密卡密明文、插件 Token 与签名密钥
MASTER_ENCRYPTION_KEY="4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a"

# ==== 安全参数 ====
SIGNATURE_WINDOW_SECONDS=300
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# ==== 安装包存储 ====
RELEASE_STORAGE_DIR="../../storage/releases"
RELEASE_MAX_SIZE_MB=2048
PUBLIC_BASE_URL="http://127.0.0.1:3100"

# 日志保留天数（api_request_logs / login_logs / license_activations）
LOG_RETENTION_DAYS=90
