# ============================================================
#  Docker 部署环境变量模板
#  用法:复制为 .env 后按注释填写,再 docker compose up -d
#      cp .env.docker.example .env
#  ⚠️ .env 含密钥,已被 .gitignore 忽略,切勿提交
# ============================================================

# ---- 容器对外端口(你自己的反代指向这里)----
# HTTP_PORT: 后台界面 + 内部已反代 /api,反代域名指向 http://127.0.0.1:8090 即可
#            (一个入口同时给后台和 API,对接方用 https://域名/api/v1)
# API_PORT : 后端 API 直连端口,http://127.0.0.1:8848,想单独给 API 挂域名时用
HTTP_PORT=8090
API_PORT=8848

# ---- 数据库(容器内 MySQL,密码自定义)----
MYSQL_ROOT_PASSWORD=换成强随机口令_root
MYSQL_DATABASE=jc_kami
MYSQL_USER=jc
MYSQL_PASSWORD=换成强随机口令_app

# ---- 初始管理员(首次启动自动创建,登录后请改密)----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=换成你的管理员密码

# ---- 公网访问地址(用于生成安装包下载链接)----
# 你的对外域名(与反代绑定的域名一致)
PUBLIC_BASE_URL=https://auth.555c.cn

# ============================================================
#  以下密钥务必用随机值替换。生成命令(每条各跑一次):
#    openssl rand -hex 32
#  MASTER_ENCRYPTION_KEY 必须正好 64 位十六进制(= openssl rand -hex 32)
#  ⚠️ LICENSE_KEY_PEPPER 与 MASTER_ENCRYPTION_KEY 一旦上线产生真实卡密后
#     绝对不能再改,否则历史卡密全部失效 / 无法解密
# ============================================================
JWT_ACCESS_SECRET=用_openssl_rand_hex_32_生成
JWT_REFRESH_SECRET=用_openssl_rand_hex_32_生成
LICENSE_TOKEN_SECRET=用_openssl_rand_hex_32_生成
LICENSE_KEY_PEPPER=用_openssl_rand_hex_32_生成
MASTER_ENCRYPTION_KEY=必须64位十六进制_用_openssl_rand_hex_32_生成
